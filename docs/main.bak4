\section{Cryptographic Analysis}
\subsection{Fernet Specification}
Fernet provides symmetric encryption using:

\begin{itemize}
	\item \textbf{Algorithm}: AES-128 in CBC mode
	\item \textbf{Padding}: PKCS7
	\item \textbf{Key Derivation}: HKDF-SHA256
	\item \textbf{Authentication}: HMAC-SHA256
	\item \textbf{IV}: Randomly generated for each encryption
\end{itemize}

\subsection{Key Derivation Process}
\begin{enumerate}
	\item Machine ID detected via platform-specific methods
	\item Salt string concatenated with machine ID
	\item SHA-256 hash computed
	\item 32-byte result base64 URL-safe encoded
	\item Fernet key initialized
\end{enumerate}

\subsection{Security Properties}
\begin{table}[htbp]
	\centering
	caption{Cryptographic Security Properties}
	\label{tbl:crypto-security}
	\begin{tabular}{|l|c|p{7cm}|}
		\hline
		\textbf{Property} & \textbf{Status}               & \textbf{Analysis}                                     \\
		\hline
		Confidentiality   & \color{green}\textbf{Strong}  & AES-128-CBC with random IV provides semantic security \\
		\hline
		Integrity         & \color{green}\textbf{Strong}  & HMAC-SHA256 prevents tampering detection              \\
		\hline
		Authenticity      & \color{green}\textbf{Strong}  & Key binding ensures source verification               \\
		\hline
		Non-Repudiation   & \color{orange}\textbf{Medium} & Machine ID derivation lacks audit trail               \\
		\hline
		Forward Secrecy   & \color{red}\textbf{Weak}      & Static key requires rotation for security             \\
		\hline
	\end{tabular}
\end{table}

