\chapter{Error Handling \& Resilience}
\cleardoublepage

\section{Error Recovery Flow}
\begin{figure}[htbp]
	\centering
	\includegraphics[width=0.95\textwidth]{\sourcespath/10-error-recovery-flow.png}
	\caption{Error Handling - Exception Management}
	\label{fig:error-handling}
\end{figure}

\textit{Figure \ref{fig:error-handling} illustrates the comprehensive error handling architecture.}

\cleardoublepage

\section{Exception Hierarchy}
\begin{table}[htbp]
	\centering
	caption{Exception Hierarchy}
	\label{tbl:exceptions}
	\begin{tabular}{|l|c|p{6cm}|}
		\hline
		\textbf{Exception} & \textbf{Base} & \textbf{Trigger Condition}      \\
		\hline
		WAuthError         & Exception     & Base for all WAuth errors       \\
		\hline
		KeyNotFoundError   & WAuthError    & Requested secret does not exist \\
		\hline
		DecryptionError    & WAuthError    & Wrong key or corrupted data     \\
		\hline
		VaultError         & WAuthError    & Database or storage failure     \\
		\hline
		BackupError        & WAuthError    & Export operation failure        \\
		\hline
		RestoreError       & WAuthError    & Import operation failure        \\
		\hline
		RotationError      & WAuthError    & Key rotation failure            \\
		\hline
		ConfigurationError & WAuthError    & Invalid configuration           \\
		\hline
	\end{tabular}
\end{table}

\section{Resilience Patterns}
\begin{enumerate}
	\item \textbf{Graceful Degradation}: Docker secrets unavailable $\to$ local vault fallback
	\item \textbf{TTL Auto-Cleanup}: Expired secrets automatically deleted on access
	\item \textbf{Partial Key Rotation}: Allows selective migration on failure
	\item \textbf{Logging Integration}: Full loguru support for diagnostics
\end{enumerate}

\cleardoublepage

