% =============================================================================
% APPENDIX B: API REFERENCE
% =============================================================================
\chapter{API Reference}
\cleardoublepage

\section{WAuth Class Methods}
\begin{longtable}{|l|p{7cm}|}
	\hline
	\textbf{Method}           & \textbf{Description}                                  \\
	\hline
	WAuth()                   & Initialize WAuth instance with optional configuration \\
	\hline
	set(key, value, ttl)      & Store encrypted text secret with optional TTL         \\
	\hline
	set\_file(key, path, ttl) & Encrypt and store file contents                       \\
	\hline
	get(key)                  & Retrieve and decrypt secret                           \\
	\hline
	delete(key)               & Permanently remove secret                             \\
	\hline
	list\_keys()              & List all stored secret keys                           \\
	\hline
	rotate\_key(new\_key)     & Re-encrypt all secrets with new key                   \\
	\hline
	backup(path)              & Export encrypted vault to JSON file                   \\
	\hline
	restore(path)             & Import secrets from backup file                       \\
	\hline
	async\_set()              & Async variant of set                                  \\
	\hline
	async\_get()              & Async variant of get                                  \\
	\hline
	async\_delete()           & Async variant of delete                               \\
	\hline
	async\_backup()           & Async variant of backup                               \\
	\hline
	async\_restore()          & Async variant of restore                              \\
	\hline
\end{longtable}

\cleardoublepage

