% =============================================================================
% CHAPTER 13: RISK ASSESSMENT
% =============================================================================
\chapter{Risk Assessment}
\cleardoublepage

\section{Technical Risk Matrix}
\begin{longtable}{|l|c|c|c|p{5cm}|}
	\hline
	\textbf{Risk Component} & \textbf{Risk Level} & \textbf{Probability} & \textbf{Impact} & \textbf{Mitigation Strategy}              \\
	\hline
	Machine ID Spoofing     & Medium              & 2                    & 4               & Use hardware-specific keys; implement TPM \\
	\hline
	Database Corruption     & Low                 & 1                    & 5               & Regular backups; integrity checksums      \\
	\hline
	Key Exposure            & High                & 2                    & 5               & Custom keys; external key management      \\
	\hline
	Concurrency Issues      & Low                 & 2                    & 3               & Connection pooling; write queue           \\
	\hline
	Version Incompatibility & Low                 & 1                    & 4               & Semantic versioning; deprecation policy   \\
	\hline
	Docker Secret Theft     & Medium              & 2                    & 4               & Least privilege; secret rotation          \\
	\hline
	Memory Exposure         & Low                 & 1                    & 4               & Clear memory; secure strings              \\
	\hline
	Side-Channel Attacks    & Low                 & 1                    & 3               & Constant-time operations; shielding       \\
	\hline
	Social Engineering      & Medium              & 3                    & 4               & Training; access controls                 \\
	\hline
	Deprecation             & Low                 & 1                    & 3               & LTS support; migration guides             \\
	\hline
\end{longtable}

\section{Mitigation Priority Matrix}
\begin{enumerate}
	\item \textbf{P0 - Critical}: Custom key management, regular rotation
	\item \textbf{P1 - High}: Backup procedures, monitoring
	\item \textbf{P2 - Medium}: Access controls, audit logging
	\item \textbf{P3 - Low}: Performance tuning, documentation
\end{enumerate}

\cleardoublepage

% =============================================================================
% CHAPTER 14: GLOSSARY
% =============================================================================
\chapter{Glossary}
\cleardoublepage

\section{Technical Terms}
\begin{longtable}{|l|p{7cm}|}
	\hline
	\textbf{Term}       & \textbf{Definition}                                                       \\
	\hline
	Fernet              & Symmetric encryption specification using AES-128-CBC with HMAC-SHA256     \\
	\hline
	Machine Locking     & Security model where encryption keys are derived from machine identifiers \\
	\hline
	TTL (Time-To-Live)  & Duration after which a secret automatically expires                       \\
	\hline
	Key Rotation        & Process of replacing encryption keys while maintaining access             \\
	\hline
	Vault               & Encrypted secret storage backed by SQLite                                 \\
	\hline
	Driver Architecture & Factory pattern supporting multiple secret sources                        \\
	\hline
	Cryptography        & Study of encryption and decryption for secure communication               \\
	\hline
	SQLite              & Embedded relational database engine                                       \\
	\hline
	wsqlite             & Python ORM library for SQLite with Pydantic integration                   \\
	\hline
	Pydantic            & Data validation library using Python type hints                           \\
	\hline
	loguru              & Structured logging library for Python                                     \\
	\hline
	AES-128-CBC         & Advanced Encryption Standard in Cipher Block Chaining mode, 128-bit key   \\
	\hline
	HMAC-SHA256         & Hash-based Message Authentication Code using SHA-256                      \\
	\hline
	SHA-256             & Secure Hash Algorithm, 256-bit output                                     \\
	\hline
\end{longtable}

\cleardoublepage

