\section{Data Formats}
\subsection{Input Types}
\begin{enumerate}
	\item \textbf{Text Secrets}: UTF-8 encoded strings
	\item \textbf{File Contents}: Binary data (certificates, keys)
\end{enumerate}

\subsection{Stored Format}
\begin{enumerate}
	\item Fernet token: Base64-encoded encrypted blob
	\item SecretModel: Pydantic model with metadata
	\item SQLite: Persistent row storage
\end{enumerate}

\subsection{Output Types}
\begin{enumerate}
	\item Text: Decoded UTF-8 string
	\item File: Raw bytes
	\item None: Key not found or expired
\end{enumerate}

\cleardoublepage

