	\label{fig:infra-topology}
\end{figure}

\textit{Figure \ref{fig:infra-topology} shows the deployment topology across host machines and containerized environments.}

\cleardoublepage

\section{Docker Integration}
WAuth supports Docker secrets through the DockerDriver:

\begin{enumerate}
	\item \textbf{Detection}: Checks for /.dockerenv or /proc/self/cgroup
	\item \textbf{Mount Path}: Reads secrets from /run/secrets by default
	\item \textbf{Fallback}: Falls back to local vault if Docker secrets unavailable
	\item \textbf{Priority}: Docker secrets checked before local vault
\end{enumerate}

\section{Deployment Patterns}
\subsection{Development Environment}
\begin{enumerate}
	\item Default: Machine-locked encryption using machine ID
	\item Database: ~/.wisrovi/wauth.db
	\item No configuration required
\end{enumerate}

\subsection{Production Environment}
\begin{enumerate}
	\item Custom key: Explicitly specify custom\_key parameter
	\item Database: Managed path with appropriate permissions
	\item Configuration: TOML file for centralized management
\end{enumerate}

\subsection{Containerized Deployment}
\begin{enumerate}
	\item Use Docker secrets for sensitive values
	\item Mount secrets to /run/secrets
	\item Consider custom keys for portability
\end{enumerate}

\cleardoublepage

