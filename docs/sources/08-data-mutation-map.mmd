%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#7c3aed', 'primaryTextColor': '#fff', 'primaryBorderColor': '#7c3aed', 'lineColor': '#6b7280', 'secondaryColor': '#f3f4f6', 'tertiaryColor': '#ffffff'}}}%%
flowchart LR
    subgraph Input["📥 INPUT"]
        P1["🔤 Plaintext String"]
        P2["📄 File Bytes"]
    end
    
    subgraph Transform["🔄 Transformation Pipeline"]
        T1[Encode UTF-8]
        T2[Read Binary]
        T3[Derive Key SHA-256]
        T4[Base64 URL-safe]
        T5[Fernet Encrypt AES-128-CBC]
        T6[Timestamp Attach]
        T7[TTL Attach]
    end
    
    subgraph Storage["💿 STORAGE"]
        S1["📝 SecretModel (Pydantic)"]
        S2["💾 SQLite Row"]
        S3["💻 Database File"]
    end
    
    subgraph Output["📤 OUTPUT FLOW"]
        O1["SELECT query"]
        O2[Decrypt]
        O3[Decode/Bytes]
        O4[Return Value]
    end
    
    P1 --> T1
    P2 --> T2
    T1 --> T3
    T2 --> T3
    T3 --> T4
    T4 --> T5
    T5 --> T6
    T6 --> T7
    T7 --> S1
    S1 --> S2
    S2 --> S3
    
    S3 -->|READ| O1
    O1 -->|SELECT| S2
    O2 -->|Fernet Decrypt| O3
    O3 -->|decode or bytes| O4
    
    style Transform fill:#ede9fe,stroke:#7c3aed,stroke-width:2px
    style Storage fill:#f3f4f6,stroke:#6b7280,stroke-width:1px
    style Output fill:#d1fae5,stroke:#059669,stroke-width:2px